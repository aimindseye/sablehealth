[run]
branch = True
relative_files = True
patch = subprocess
include =
    tools/check_mobsf_findings.py
    tools/check-m1a-contract.py
    tools/check-r5-contract.py
    tools/check-structure.py
    tools/quality_preflight.py
    tools/verify-release-apk.py
